{
  "name": "@ftschindler/linkspector-pre-commit",
  "version": "0.1.0",
  "description": "A pre-commit hook that runs linkspector over the files pre-commit passes it, with the browser behind it pinned.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "linkspector-changed": "bin/linkspector-changed.js",
    "linkspector-all": "bin/linkspector-all.js"
  },
  "files": [
    "bin",
    "scripts"
  ],
  "scripts": {
    "check-pins": "node scripts/check-pins.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@umbrelladocs/linkspector": "0.5.6",
    "puppeteer": "25.12.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftschindler/linkspector-pre-commit.git"
  },
  "devDependencies": {
    "semver": "7.8.5"
  }
}
